{
  "name": "@pinbean/palette-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./color-system-mapping.json": "./colorSystemMapping.json"
  },
  "files": [
    "colorSystemMapping.json",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@pinbean/bead-core": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
